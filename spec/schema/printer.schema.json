{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/WiFiLabel/label-toolkit/spec/schema/printer.schema.json",
  "title": "Printer profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "displayName",
    "languages",
    "dpi",
    "maxWidthDots",
    "speed",
    "darkness",
    "usb",
    "verified",
    "notes",
    "summary",
    "explain",
    "sourceRef"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "displayName": { "type": "string", "minLength": 2 },
    "languages": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["zpl", "epl2", "tspl", "escpos"] }
    },
    "dpi": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "integer", "minimum": 100 }
    },
    "maxWidthDots": { "type": "integer", "minimum": 1 },
    "speed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max", "units"],
      "properties": {
        "min": { "type": "number" },
        "max": { "type": "number" },
        "units": { "const": "ips" }
      }
    },
    "darkness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": { "type": "number" },
        "max": { "type": "number" }
      }
    },
    "usb": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vendorId", "productIds"],
      "properties": {
        "vendorId": { "type": "integer" },
        "productIds": { "type": "array", "items": { "type": "integer" } }
      }
    },
    "verified": { "type": "boolean" },
    "notes": { "type": "string" },
    "summary": { "type": "string", "minLength": 12 },
    "explain": { "type": "string", "minLength": 40 },
    "sourceRef": {
      "type": "string",
      "pattern": "^https://docs\\.zebra\\.com/"
    }
  }
}
