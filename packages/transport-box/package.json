{
  "name": "@wifilabel/box-client",
  "version": "0.1.1",
  "description": "Stub client for a WiFiLabel box on the local network.",
  "keywords": [
    "label-printer",
    "print-server",
    "thermal-printer"
  ],
  "homepage": "https://wifilabel.com/",
  "bugs": {
    "url": "https://github.com/WiFiLabel/label-toolkit/issues"
  },
  "license": "MIT",
  "author": "WiFiLabel <hello@wifilabel.com>",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WiFiLabel/label-toolkit.git",
    "directory": "packages/transport-box"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "dependencies": {
    "@wifilabel/transport": "workspace:*"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "9.0.0",
    "typescript": "5.9.3"
  }
}
