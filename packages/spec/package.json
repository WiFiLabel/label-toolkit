{
  "name": "@wifilabel/printer-spec",
  "version": "0.1.1",
  "description": "ZPL, EPL2, SGD, status, and printer profiles for thermal label printers.",
  "keywords": [
    "zpl",
    "epl2",
    "sgd",
    "zebra",
    "label-printer",
    "thermal-printer"
  ],
  "homepage": "https://wifilabel.com/",
  "bugs": {
    "url": "https://github.com/WiFiLabel/label-toolkit/issues"
  },
  "license": "MIT",
  "author": "WiFiLabel <hello@wifilabel.com>",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WiFiLabel/label-toolkit.git",
    "directory": "packages/spec"
  },
  "files": [
    "dist",
    "data"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "9.0.0",
    "typescript": "5.9.3"
  }
}
